# ARGUS backend configuration. Copy to backend/.env and adjust.
# Every setting is optional; the defaults run fully locally and for free.
# Never commit a real .env file.

# ── General ───────────────────────────────────────────────────────────
ARGUS_ENVIRONMENT=development          # development | test | production
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=false                   # one JSON object per log line
ARGUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Market data (free) ────────────────────────────────────────────────
# yfinance = free Yahoo Finance data (unofficial, possibly delayed)
# fixture  = deterministic synthetic data for offline development
ARGUS_MARKET_DATA_PROVIDER=yfinance
ARGUS_PROVIDER_TIMEOUT_SECONDS=45
ARGUS_PROVIDER_REQUEST_TIMEOUT_SECONDS=12
ARGUS_PROVIDER_MAX_ATTEMPTS=3
ARGUS_PROVIDER_MAX_CONCURRENCY=1

# ── Analytics defaults ────────────────────────────────────────────────
ARGUS_QUANT_BENCHMARK_TICKER=SPY
ARGUS_QUANT_ANNUAL_RISK_FREE_RATE=0.0  # annual decimal, e.g. 0.04 for 4%

# ── Persistence ───────────────────────────────────────────────────────
# Local data (SQLite DB, ChromaDB index, uploads) lives here by default.
# ARGUS_DATA_DIR=/absolute/path/to/argus-data   # default: backend/.argus (relative paths resolve against the working directory)
# Leave unset for SQLite; for PostgreSQL:
# ARGUS_DATABASE_URL=postgresql+psycopg://argus:CHANGE_ME@localhost:5432/argus
ARGUS_AUTO_MIGRATE=true

# ── Auth ──────────────────────────────────────────────────────────────
ARGUS_SESSION_TTL_HOURS=168
ARGUS_SESSION_COOKIE_SECURE=false      # set true when served over HTTPS
ARGUS_AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Documents / retrieval ─────────────────────────────────────────────
ARGUS_EMBEDDING_PROVIDER=onnx          # onnx = local MiniLM (free, ~80 MB download once); hash = offline/tests
ARGUS_MAX_UPLOAD_BYTES=15000000
ARGUS_KNOWLEDGE_RETRIEVAL_LIMIT=4
ARGUS_KNOWLEDGE_MIN_SCORE=0.15

# ── SEC EDGAR filings (free) ──────────────────────────────────────────
# Required by SEC fair-access policy to enable filings: name + contact email.
# ARGUS_SEC_USER_AGENT="ARGUS research tool your-email@example.com"

# ── Optional language model for research synthesis ────────────────────
# Default "none" = deterministic, evidence-grounded reports (no model, no cost).
#
# Option A — a LOCAL model, e.g. Ollama (`ollama pull qwen2.5:7b`):
# ARGUS_LLM_PROVIDER=openai_compatible
# ARGUS_LLM_MODEL=qwen2.5:7b
# ARGUS_LLM_BASE_URL=http://localhost:11434/v1
#
# Option B — a free-tier hosted endpoint such as Groq (no billing unless you add
# a payment method on their side). Put the real key only in backend/.env:
# ARGUS_LLM_PROVIDER=openai_compatible
# ARGUS_LLM_MODEL=openai/gpt-oss-120b
# ARGUS_LLM_BASE_URL=https://api.groq.com/openai/v1
# ARGUS_LLM_API_KEY=your-groq-key
# ARGUS_LLM_ALLOW_REMOTE=true
#
# Remote endpoints are refused unless ARGUS_LLM_ALLOW_REMOTE=true, so a remote
# (possibly paid) API can never be used by accident.
ARGUS_LLM_ALLOW_REMOTE=false
ARGUS_API_RATE_LIMIT_PER_MINUTE=120

# ARGUS Configuration Variables

# General Settings
ARGUS_APP_NAME="ARGUS API"
ARGUS_APP_VERSION="0.1.0"

# Data Provider (yfinance or mock)
ARGUS_MARKET_DATA_PROVIDER="yfinance"

# Quant Engine Defaults
ARGUS_QUANT_BENCHMARK_TICKER="SPY"
ARGUS_QUANT_HISTORY_PERIOD="1y"
ARGUS_QUANT_ANNUAL_RISK_FREE_RATE="0.0"

# Knowledge Retrieval
ARGUS_KNOWLEDGE_COLLECTION_NAME="argus_knowledge"
# ARGUS_KNOWLEDGE_CHROMA_PATH=".argus/chroma" # Set to /tmp/.argus/chroma in Vercel automatically
